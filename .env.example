# ── FRED API ──────────────────────────────────────────────────────────────────
# Register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── AWS Credentials ───────────────────────────────────────────────────────────
# IAM user with s3:GetObject / s3:PutObject on the target bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1

# ── Airflow (optional overrides for airflow standalone) ───────────────────────
# AIRFLOW__CORE__DAGS_FOLDER=./dags
# AIRFLOW__SMTP__SMTP_HOST=smtp.example.com
# AIRFLOW__SMTP__SMTP_MAIL_FROM=data-eng@example.com
